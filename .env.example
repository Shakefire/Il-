# Ilé environment example — copy to .env / .env.local (never commit real secrets)

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (Neon / Postgres). Prefer a non-prod branch for local work.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Auth
SESSION_SECRET=replace_with_at_least_32_character_secret_value
SESSION_MAX_AGE_DAYS=7

# Frontend / CORS
FRONTEND_URL=http://localhost:3000

# Paystack — secret stays server-side only; Flutter/web never hold it
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MOCK_TRANSFERS=true

# Email
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Ilé <hello@notifications.ilestays.ng>
EMAIL_SUPPORT=support@ilestays.ng
EMAIL_ENQUIRIES=info@ilestays.ng

# SMS (Termii)
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=IleStays

# Push (FCM)
PUSH_PROVIDER=console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push (VAPID)
WEB_PUSH_PROVIDER=console
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@ilestays.ng

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=storageapp
R2_FOLDER_PREFIX=storageapp/ilestays.ng/
R2_PUBLIC_URL=
