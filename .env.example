# ─────────────────────────────────────────────────
# Ilé — Nigerian Accommodation Marketplace
# Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for production.
# Variables marked [OPTIONAL] have sensible defaults.
# ─────────────────────────────────────────────────

# ─── Core ───
NODE_ENV=development                         # [OPTIONAL] development | production | test
PORT=4000                                    # [OPTIONAL] Backend API port
LOG_LEVEL=info                               # [OPTIONAL] fatal | error | warn | info | debug | trace

# ─── Database ───
# DATABASE_URL=postgresql://user:pass@host:5432/ile_db?sslmode=require  # [REQUIRED for prod] PostgreSQL connection string
# Leave empty for dev to use embedded PGlite (zero-config)

# ─── Auth / Security ───
# SESSION_SECRET=your-64-char-hex-secret     # [REQUIRED for prod] Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_MAX_AGE_DAYS=7                       # [OPTIONAL] Session duration in days

# ─── Cloudflare R2 (Image Storage) ───
# R2_ACCOUNT_ID=                             # [OPTIONAL] Cloudflare account ID
# R2_ACCESS_KEY_ID=                          # [OPTIONAL] R2 API key ID
# R2_SECRET_ACCESS_KEY=                      # [OPTIONAL] R2 API secret
# R2_BUCKET_NAME=ile-media                   # [OPTIONAL] R2 bucket name
# R2_PUBLIC_URL=https://pub-xxx.r2.dev       # [OPTIONAL] R2 public CDN URL

# ─── Email (Transactional) ───
# EMAIL_API_KEY=re_xxxxx                     # [OPTIONAL] Resend or SendGrid API key
EMAIL_FROM=noreply@ile.ng                    # [OPTIONAL] Verified sender email
EMAIL_PROVIDER=console                       # [OPTIONAL] resend | sendgrid | console (logs to terminal)

# ─── Payments (Paystack) ───
# PAYSTACK_SECRET_KEY=sk_test_xxxxx          # [REQUIRED for prod] Paystack secret key
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxx          # [OPTIONAL] Paystack public key (for frontend)

# ─── Frontend ───
FRONTEND_URL=http://localhost:3000           # [OPTIONAL] Frontend URL for CORS and email links

# ─── Geocoding ───
GEOCODING_API_URL=https://nominatim.openstreetmap.org  # [OPTIONAL] Nominatim (free, no key)
